@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model ShivaEnterpriseWebApp.Model.Outward

@{
    SelectList CustomerDropdownList = ViewBag.customerSelectList ?? new SelectList(new List<SelectListItem>()); ;
    SelectList ProductDropdownList = ViewBag.ProductSelectList ?? new SelectList(new List<SelectListItem>()); ;
    SelectList SaleOrderDropdownList = ViewBag.SaleOrderSelectList ?? new SelectList(new List<SelectListItem>());
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Outward</title>
    <!-- Bootstrap CSS -->
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Optional custom styles */
        .form-label {
            font-weight: bold;
        }

        .container {
            overflow-x: auto;
            white-space: nowrap;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1 class="text-center">Outward Form</h1>
        <form controller="Outward" asp-controller="Outward" asp-action="AddOrEditOutward" method="post">
            @* @Html.HiddenFor(model => model.SalesOrderId)
            @Html.HiddenFor(model => model.CustomerId)
            @Html.HiddenFor(model => model.ProductId) *@
            @Html.HiddenFor(model => model.OutwardId)
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">SaleOrder:</label>
                        @Html.DropDownListFor(model => model.SalesOrderId, SaleOrderDropdownList, "Select an option", new { @class = "form-control", id = "SaleOrderId" })
                    </div>

                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Customer:</label>
                        @Html.DropDownListFor(model => model.CustomerId, CustomerDropdownList, "Select an option", new { @class = "form-control", id = "CustomerId" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Product:</label>
                        @Html.DropDownListFor(model => model.ProductId, ProductDropdownList, "Select an option", new { @class = "form-control", id = "ProductId" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">ShipmentDate:</label>
                        <input type="date" id="shipmentDate" class="form-control" asp-for="ShipmentDate">
                        @Html.ValidationMessageFor(m => m.ShipmentDate, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">ShippedBy:</label>
                        <input type="text" id="shippedById" class="form-control" asp-for="ShippedBy" value=@Model.ShippedBy>
                        @Html.ValidationMessageFor(m => m.ShippedBy, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">QuantityShipped:</label>
                        <input type="number" id="quantityShippedId" class="form-control" asp-for="QuantityShipped" value=@Model.QuantityShipped>
                        @Html.ValidationMessageFor(m => m.QuantityShipped, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">UnitOfMeasure:</label>
                        <input type="text" id="UnitOfMeasureId" class="form-control" asp-for="UnitOfMeasure" value=@Model.UnitOfMeasure>
                        @Html.ValidationMessageFor(m => m.UnitOfMeasure, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Batch Number:</label>
                        <input type="text" id="BatchNumberId" class="form-control" asp-for="BatchNumber" value=@Model.BatchNumber>
                        @Html.ValidationMessageFor(model => model.BatchNumber, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Carrier ID:</label>
                        <input type="number" id="CarrierId" class="form-control" asp-for="CarrierId" value=@Model.CarrierId>
                        @Html.ValidationMessageFor(m => m.CarrierId, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Carrier Name:</label>
                        <input type="text" id="CarrierNameId" class="form-control" asp-for="CarrierName" value=@Model.CarrierName>
                        @Html.ValidationMessageFor(m => m.CarrierName, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Tracking Number:</label>
                        <input type="text" id="TrackingNumber" class="form-control" asp-for="TrackingNumber" value=@Model.TrackingNumber>
                        @Html.ValidationMessageFor(m => m.TrackingNumber, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Shipping Method:</label>
                        <input type="text" id="ShippingMethod" class="form-control" asp-for="ShippingMethod" value=@Model.ShippingMethod>
                        @Html.ValidationMessageFor(m => m.ShippingMethod, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Delivery Date:</label>
                        <input type="date" id="DeliveryDate" class="form-control" asp-for="DeliveryDate">
                        @Html.ValidationMessageFor(m => m.DeliveryDate, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Delivery Address:</label>
                        <input type="text" id="DeliveryAddress" class="form-control" asp-for="DeliveryAddress" value=@Model.DeliveryAddress>
                        @Html.ValidationMessageFor(m => m.DeliveryAddress, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Invoice Date:</label>
                        <input type="date" id="InvoiceDate" class="form-control" asp-for="InvoiceDate">
                        @Html.ValidationMessageFor(m => m.InvoiceDate, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">CostPerUnit:</label>
                        <input type="number" id="CostPerUnit" class="form-control" asp-for="CostPerUnit" value=@Model.CostPerUnit>
                        @Html.ValidationMessageFor(m => m.CostPerUnit, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Currency:</label>
                        <input type="text" id="Currency" class="form-control" asp-for="Currency" value=@Model.Currency />
                        @Html.ValidationMessageFor(m => m.Currency, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Total Cost:</label>
                        <input type="number" id="TotalCost" class="form-control" asp-for="TotalCost" value=@Model.TotalCost>
                        @Html.ValidationMessageFor(m => m.TotalCost, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Remarks:</label>
                        <input type="text" id="Remarks" class="form-control" asp-for="Remarks" value=@Model.Remarks>
                        @Html.ValidationMessageFor(m => m.Remarks, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">CreatedBy:</label>
                        <input type="text" id="CreatedBy" class="form-control" asp-for="CreatedBy" value=@Model.CreatedBy>
                        @Html.ValidationMessageFor(m => m.CreatedBy, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Created Date:</label>
                        <input type="date" id="CreatedDate" class="form-control" asp-for="CreatedDate">
                        @Html.ValidationMessageFor(m => m.CreatedDate, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                </div>
            </div>

            <button type="submit" class="btn btn-primary" id="btnSave">Submit</button>
        </form>
    </div>
    <!-- Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="~/js/Outwards.js"></script>
</body>
</html>
