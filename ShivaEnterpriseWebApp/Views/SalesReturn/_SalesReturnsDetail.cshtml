@model List<ShivaEnterpriseWebApp.Model.SalesReturnDetail>
@using ShivaEnterpriseWebApp.Model
@{
    SalesReturnDetail SalesReturnDetail = new SalesReturnDetail();
    SelectList ProductDropdownList = ViewBag.ProductSelectList;
    SelectList BrandDropdownList = ViewBag.BrandSelectList;
}


<div id="sodetaildiv">
    <table id="tblSalesReturnDetail" class="table" cellpadding="0" cellspacing="0">
        <thead>
            <tr>
                <th class="d-none"></th>
                <th class="d-none"></th>
                <th class="d-none"></th>
                <th class="d-none"></th>
                <th style="width:150px">Product</th>
                <th style="width:150px">Brand</th>
                <th style="width:150px">Qty</th>
                <th style="width:150px">Unitprice</th>
                <th style="width:150px">Discount</th>
                <th style="width:150px">NetTotal</th>
                <th class="d-none enable_disable" style="width:150px">
                    Enable/Disable
                </th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                @foreach (var sodetail in Model)
                {
                    <tr>
                        <td class="d-none SalesReturnDetailId-cell">@sodetail.SalesReturnDetailId</td>
                        <td class="d-none SalesReturnId-cell">@sodetail.SalesReturnId</td>
                        <td class="d-none productId-cell">@sodetail.Product.ProductId</td>
                        <td class="d-none brandId-cell">@sodetail.Brand.BrandId</td>
                        @* <td class="d-none createdby-cell">@podetail.CreatedBy</td>
                <td class="d-none createddate-cell">@podetail.CreatedDateTime</td> *@
                        <td class="product-cell">@sodetail.Product.ProductName</td>
                        <td class="brand-cell">@sodetail.Brand.BrandName</td>
                        <td class="qty-cell">@sodetail.Quantity</td>
                        <td class="unitprice-cell">@sodetail.UnitPrice</td>
                        <td class="discount-cell">@sodetail.Discount</td>
                        <td class="nettotal-cell">@sodetail.NetTotal</td>
                        <td><input class="d-none" id="enable_disable" type="checkbox" value="false"></td>
                        <td><input class="d-none" id="btnupdate" type="button" value="Update" /></td>
                        <td><input type="button" value="Remove" onclick="Remove(this)" /></td>
                    </tr>
                }
            }

        </tbody>
        <tfoot>
            <tr>
                <td class="d-none"></td>
                <td class="d-none"></td>
                <td class="d-none"></td>
                <td class="d-none"></td>
                <td>@Html.DropDownList(SalesReturnDetail.ProductId.ToString(), ProductDropdownList, "Select an option", new { id = "ProductId", @class = "form-control", required = "required" })</td>
                @Html.ValidationMessage(SalesReturnDetail.ProductId.ToString(), new { @class = "text-danger" })
                <td>@Html.DropDownList(SalesReturnDetail.BrandId.ToString(), BrandDropdownList, "Select an option", new { id = "BrandId" })</td>
                <td><input type="text" id="txtsoQty" required /></td>
                <td><input type="text" id="txtsoUnitprice" required /></td>
                <td><input type="text" id="txtsoDiscount"  /></td>
                <td><input type="text" id="txtsonetTotal" readonly /></td>
                <td><input type="button" id="btnsalesAdd" value="Add" /></td>
            </tr>
        </tfoot>
    </table>
</div>
<br />
<script type="text/javascript" src="http://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<script type="text/javascript" src="http://ajax.cdnjs.com/ajax/libs/json2/20110223/json2.js"></script>

