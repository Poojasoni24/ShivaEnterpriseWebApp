@model ShivaEnterpriseWebApp.Model.SalesOrderViewModel
@{

    SelectList customerDropdownList = ViewBag.CustomerSelectList;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Purchase Order</title>
    <!-- Bootstrap CSS -->
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Optional custom styles */
        .form-label {
            font-weight: bold;
        }

        .container {
            overflow-x: auto;
            white-space: nowrap;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1 class="text-center">Sales Order Form</h1>
        <form controller="SalesOrder" action="AddOrEditSalesOrder" method="post">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Doc_No:</label>
                        <input type="text" class="form-control" id="docNo" asp-for="SalesOrder.Doc_No">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Customer:</label>
                        @Html.DropDownListFor(model => model.SalesOrder.CustomerId, customerDropdownList, "Select an option", new { @class = "form-control" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Order Date:</label>
                        <input type="date" class="form-control" asp-for="SalesOrder.OrderDate">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">DeliveryDate:</label>
                        <input type="date" class="form-control" asp-for="SalesOrder.DeliveryDate">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Customer Discount:</label>
                        <input type="text" id="customerDiscount" class="form-control" id="txtCustomerDiscount" asp-for="SalesOrder.Customer.CustomerDiscount" readonly>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Total Amount:</label>
                            <input type="number" id="totalNumber" class="form-control" asp-for="SalesOrder.TotalAmount">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label">Tax:</label>
                            <input type="text" id="tax" class="form-control" asp-for="SalesOrder.Tax_Percentage" value="12">
                        </div>
                        <input asp-for="SalesOrder.CreatedDateTime" class="form-control" type="hidden" />
                        <input asp-for="SalesOrder.CreatedBy" class="form-control" type="hidden" />
                        <input asp-for="SalesOrder.SalesOrderId" class="form-control" type="hidden" />
                    </div>
                </div>
                <hr style="width:100%" />
                <div id="poDetailPartial">
                    @if (Model != null && Model.SODetail != null)
                    {
                        @Html.Partial("_SalesOrderDetail", Model.SODetail)

                    }
                    else
                    {
                        @Html.Partial("_SalesOrderDetail")
                    }
                </div>

                <button type="submit" class="btn btn-primary" id="btnSalesSave">Submit</button>
        </form>
    </div>
    <!-- Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="~/js/SalesOrder.js"></script>
    <script src="~/js/SalesOrderDetail.js"></script>
</body>
</html>
