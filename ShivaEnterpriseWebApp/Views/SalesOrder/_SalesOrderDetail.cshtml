@model List<ShivaEnterpriseWebApp.Model.SalesOrderDetail>
@using ShivaEnterpriseWebApp.Model
@{
    SalesOrderDetail salesOrderDetail = new SalesOrderDetail();
    SelectList ProductDropdownList = ViewBag.ProductSelectList;
    SelectList BrandDropdownList = ViewBag.BrandSelectList;
}


<div id="sodetaildiv">
    <table id="tblSalesOrderDetail" class="table" cellpadding="0" cellspacing="0">
        <thead>
            <tr>
                <th class="d-none"></th>
                <th class="d-none"></th>
                <th style="width:150px">Product</th>
                <th style="width:150px">Brand</th>
                <th style="width:150px">Qty</th>
                <th style="width:150px">Unitprice</th>
                <th style="width:150px">Discount</th>
                <th style="width:150px">NetTotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                @foreach (var sodetail in Model)
                {
                    <tr>
                        <td class="d-none">@sodetail.Product.ProductId</td>
                        <td class="d-none">@sodetail.Brand.BrandId</td>
                        <td>@sodetail.Product.ProductName</td>
                        <td>@sodetail.Brand.BrandName</td>
                        <td>@sodetail.Quantity</td>
                        <td>@sodetail.UnitPrice</td>
                        <td>@sodetail.Discount</td>
                        <td>@sodetail.NetTotal</td>
                        <td><input type="button" value="Remove" onclick="Remove(this)" /></td>
                    </tr>
                }
            }

        </tbody>
        <tfoot>
            <tr>
                <td class="d-none"></td>
                <td class="d-none"></td>
                <td>@Html.DropDownList(salesOrderDetail.ProductId.ToString(), ProductDropdownList, "Select an option", new { id = "ProductId" })</td>
                <td>@Html.DropDownList(salesOrderDetail.BrandId.ToString(), BrandDropdownList, "Select an option", new { id = "BrandId" })</td>
                <td><input type="text" id="txtsoQty" /></td>
                <td><input type="text" id="txtsoUnitprice" /></td>
                <td><input type="text" id="txtsoDiscount" /></td>               
                <td><input type="text" id="txtsonetTotal" /></td>
                <td><input type="button" id="btnAdd" value="Add" /></td>
            </tr>
        </tfoot>
    </table>
</div>
<br />
<script type="text/javascript" src="http://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<script type="text/javascript" src="http://ajax.cdnjs.com/ajax/libs/json2/20110223/json2.js"></script>

