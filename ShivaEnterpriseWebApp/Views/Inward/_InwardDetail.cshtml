@model ShivaEnterpriseWebApp.Model.InwardViewModel
@using ShivaEnterpriseWebApp.Model
@{
    SelectList productDropdownList = new SelectList(Model.Products, "ProductId", "ProductName");
}

<div id="inwardDetailDiv">
    <table id="tblInwardDetail" class="table" cellpadding="0" cellspacing="0">
        <thead>
            <tr>
                <th>Product</th>
                <th>Quantity Received</th>
                <th>Unit Of Measure</th>
                <th>Batch Number</th>
                <th>Quality Check Status</th>
                <th>Quality Check Remarks</th>
                <th>Invoice Number</th>
                <th>Invoice Date</th>
                <th>Cost Per Unit</th>
                <th>Total Cost</th>
                <th>Remarks</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                <tr>
                    <td>@Html.DropDownListFor(m => m.ProductId, productDropdownList, "Select a product", new { @class = "form-control" })</td>
                    <td><input type="number" class="form-control" asp-for="QuantityReceived" required /></td>
                    <td><input type="text" class="form-control" asp-for="UnitOfMeasure" /></td>
                    <td><input type="text" class="form-control" asp-for="BatchNumber" /></td>
                    <td><input type="text" class="form-control" asp-for="QualityCheckStatus" /></td>
                    <td><input type="text" class="form-control" asp-for="QualityCheckRemarks" /></td>
                    <td><input type="text" class="form-control" asp-for="InvoiceNumber" /></td>
                    <td><input type="date" class="form-control" asp-for="InvoiceDate" /></td>
                    <td><input type="number" class="form-control" asp-for="CostPerUnit" required /></td>
                    <td><input type="number" class="form-control" asp-for="TotalCost" required /></td>
                    <td><input type="text" class="form-control" asp-for="Remarks" /></td>
                    <td><input type="button" class="btn btn-danger" value="Remove" onclick="Remove(this)" /></td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td>@Html.DropDownList("NewProductId", productDropdownList, "Select a product", new { @class = "form-control", required = "required" })</td>
                <td><input type="number" class="form-control" id="newQuantityReceived" required /></td>
                <td><input type="text" class="form-control" id="newUnitOfMeasure" /></td>
                <td><input type="text" class="form-control" id="newBatchNumber" /></td>
                <td><input type="text" class="form-control" id="newQualityCheckStatus" /></td>
                <td><input type="text" class="form-control" id="newQualityCheckRemarks" /></td>
                <td><input type="text" class="form-control" id="newInvoiceNumber" /></td>
                <td><input type="date" class="form-control" id="newInvoiceDate" /></td>
                <td><input type="number" class="form-control" id="newCostPerUnit" required /></td>
                <td><input type="number" class="form-control" id="newTotalCost" required /></td>
                <td><input type="text" class="form-control" id="newRemarks" /></td>
                <td><input type="button" class="btn btn-success" id="btnAdd" value="Add" /></td>
            </tr>
        </tfoot>
    </table>
</div>
<br />
<script>
    $(document).ready(function () {
        function calculateTotalCost() {
            var unitPrice = parseFloat($('#newCostPerUnit').val());
            var quantity = parseFloat($('#newQuantityReceived').val());
            var totalPrice = unitPrice * quantity;
            $('#newTotalCost').val(totalPrice.toFixed(2));
        }

        $('#newCostPerUnit, #newQuantityReceived').on('input', function () {
            calculateTotalCost();
        });

        $('#btnAdd').click(function () {
            var newRow = '<tr>' +
                '<td>' + $('#NewProductId').html() + '</td>' +
                '<td><input type="number" class="form-control" name="QuantityReceived" value="' + $('#newQuantityReceived').val() + '" required /></td>' +
                '<td><input type="text" class="form-control" name="UnitOfMeasure" value="' + $('#newUnitOfMeasure').val() + '" /></td>' +
                '<td><input type="text" class="form-control" name="BatchNumber" value="' + $('#newBatchNumber').val() + '" /></td>' +
                '<td><input type="text" class="form-control" name="QualityCheckStatus" value="' + $('#newQualityCheckStatus').val() + '" /></td>' +
                '<td><input type="text" class="form-control" name="QualityCheckRemarks" value="' + $('#newQualityCheckRemarks').val() + '" /></td>' +
                '<td><input type="text" class="form-control" name="InvoiceNumber" value="' + $('#newInvoiceNumber').val() + '" /></td>' +
                '<td><input type="date" class="form-control" name="InvoiceDate" value="' + $('#newInvoiceDate').val() + '" /></td>' +
                '<td><input type="number" class="form-control" name="CostPerUnit" value="' + $('#newCostPerUnit').val() + '" required /></td>' +
                '<td><input type="number" class="form-control" name="TotalCost" value="' + $('#newTotalCost').val() + '" required /></td>' +
                '<td><input type="text" class="form-control" name="Remarks" value="' + $('#newRemarks').val() + '" /></td>' +
                '<td><input type="button" class="btn btn-danger" value="Remove" onclick="Remove(this)" /></td>' +
                '</tr>';
            $('#tblInwardDetail tbody').append(newRow);
            $('#newQuantityReceived').val('');
            $('#newUnitOfMeasure').val('');
            $('#newBatchNumber').val('');
            $('#newQualityCheckStatus').val('');
            $('#newQualityCheckRemarks').val('');
            $('#newInvoiceNumber').val('');
            $('#newInvoiceDate').val('');
            $('#newCostPerUnit').val('');
            $('#newTotalCost').val('');
            $('#newRemarks').val('');
        });

        window.Remove = function (button) {
            $(button).closest('tr').remove();
        }
    });
</script>
