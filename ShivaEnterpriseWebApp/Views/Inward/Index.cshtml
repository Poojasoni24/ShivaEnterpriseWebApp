@using Newtonsoft.Json
@using ShivaEnterpriseWebApp.Model
@model List<ShivaEnterpriseWebApp.Model.Inward>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<body>
    <!-- partial -->
    <div class="main-panel">
        <div class="content-wrapper">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Inward Detail</h4>
                    <div class="compnay_btn">
                        <input class="btn btn-success" type="button" value="Add Inward Detail" onclick="window.location.replace('/Inward/AddOrEditInward')" />
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="table-responsive">
                                <table id="order-listing" class="table">
                                    <thead>
                                        <tr>
                                            <th>ProductName</th>
                                            <th>QuantityReceived</th>
                                            <th>UnitOfMeasure</th>
                                            <th>BatchNumber</th>
                                            <th>QualityCheckStatus</th>
                                            <th>InvoiceNumber</th>
                                            <th>InvoiceDate</th>
                                            <th>CostPerUnit</th>
                                            <th>TotalCost</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null)
                                        {
                                            @foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@item.Product.ProductName</td>
                                                    <td>@item.QuantityReceived</td>
                                                    <td>@item.UnitOfMeasure</td>
                                                    <td>@item.BatchNumber</td>
                                                    <td>@item.QualityCheckStatus</td>
                                                    <td>@item.InvoiceNumber</td>
                                                    <td>@item.InvoiceDate.ToShortDateString()</td>
                                                    <td>@item.CostPerUnit</td>
                                                    <td>@item.TotalCost</td>
                                                    <td>
                                                        <input class="btn btn-primary" type="button" value="Edit" onclick="window.location.replace(`/Inward/AddOrEditInward?inwardId=@item.InwardId`)" />
                                                        <input class="btn btn-outline-danger" type="button" value="Delete" onclick="onDeleteInward(@(JsonConvert.SerializeObject(item)))" />
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- content-wrapper ends -->
    </div>
</body>
</html>

<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="~/js/Inwards.js"></script>
