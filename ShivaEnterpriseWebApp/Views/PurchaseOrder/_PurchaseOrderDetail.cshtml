@model List<ShivaEnterpriseWebApp.Model.PurchaseOrderDetail>
@using ShivaEnterpriseWebApp.Model
@{
    PurchaseOrderDetail purchaseOrderDetail = new PurchaseOrderDetail();
    SelectList ProductDropdownList = ViewBag.ProductSelectList;
    SelectList BrandDropdownList = ViewBag.BrandSelectList;
}


<div id="podetaildiv">
    <table id="tblPurchaseOrderDetail" class="table" cellpadding="0" cellspacing="0">
        <thead>
            <tr>
                <th class="d-none"></th>
                <th class="d-none"></th>
                <th class="d-none"></th>
                <th class="d-none"></th>
                <th class="d-none"></th>
                <th class="d-none"></th>
                <th style="width:280px">Product</th>
                <th style="width:280px">Brand</th>
                <th style="width:280px">Qty</th>
                <th style="width:280px">Unitprice</th>
                <th style="width:280px">Discount</th>
                <th style="width:280px">NetTotal</th>
                <th class="d-none enable_disable" style="width:150px">
                    Enable/Disable</th>
                @* <th></th> *@
                <th></th>
               
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                @foreach (var podetail in Model)
                {
                    <tr>
                        <td class="d-none purchaseOrderDetailId-cell">@podetail.PurchaseOrderDetailId</td>
                        <td class="d-none purchaseOrderId-cell">@podetail.PurchaseOrderId</td>
                        <td class="d-none productId-cell">@podetail.Product.ProductId</td>
                        <td class="d-none brandId-cell">@podetail.Brand.BrandId</td>
                        <td class="d-none createdby-cell">@podetail.CreatedBy</td>
                        <td class="d-none createddate-cell">@podetail.CreatedDateTime</td>
                        <td class="product-cell">@podetail.Product.ProductName</td>
                        <td class="brand-cell">@podetail.Brand.BrandName</td>
                        <td class="qty-cell">@podetail.Quantity</td>
                        <td class="unitprice-cell">@podetail.UnitPrice</td>
                        <td class="discount-cell">@podetail.Discount</td>
                        <td class="nettotal-cell">@podetail.NetTotal</td>
                        <td><input class="d-none" id="enable_disable" type="checkbox" value="false"></td>
                        <td><input class="d-none" id="btnupdate" type="button" value="Update" /></td>
                        <td><input type="button" value="Remove" onclick="Remove(this)" /></td>
                    </tr>
                }
            }

        </tbody>
        <tfoot>
            <tr>
                <td class="d-none"></td>
                <td class="d-none"></td>
                <td class="d-none"></td>
                <td class="d-none"></td>
                <td class="d-none"></td>
                <td class="d-none"></td>
                <td style ="width:280px">
                    @Html.DropDownList(purchaseOrderDetail.ProductId.ToString(), ProductDropdownList, "Select an option", new { id = "ProductId", @class = "form-control", required = "required" })
                    @Html.ValidationMessage(purchaseOrderDetail.ProductId.ToString(), new { @class = "text-danger" })
                </td>
                <td style ="width:280px">
                    @Html.DropDownList(purchaseOrderDetail.BrandId.ToString(), BrandDropdownList, "Select an option", new { @class = "form-control", id = "BrandId" })
                </td>
                <td style="width:280px"><input class="form-control" type="text" id="txtQty" required /></td>
                <td style="width:280px"><input class="form-control" type="text" id="txtUnitprice" required /></td>
                <td style="width:280px"><input class="form-control" type="text" id="txtDiscount" /></td>
                <td style="width:280px"><input class="form-control" type="text" id="txtnetTotal" readonly /></td>
                <td style="width:280px"><input type="button" id="btnAdd" value="Add" /></td>
            </tr>
        </tfoot>
    </table>
</div>
<br />
<script type="text/javascript" src="http://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<script type="text/javascript" src="http://ajax.cdnjs.com/ajax/libs/json2/20110223/json2.js"></script>
