@model ShivaEnterpriseWebApp.Model.PurchaseOrderViewModel
@{
    SelectList vendorDropdownList = ViewBag.VendorSelectList;
    SelectList ProductDropdownList = ViewBag.ProductSelectList;
    SelectList BrandDropdownList = ViewBag.BrandSelectList;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Purchase Order</title>
    <!-- Bootstrap CSS -->
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Optional custom styles */
        .form-label {
            font-weight: bold;
        }

        .container {
            overflow-x: auto;
            white-space: nowrap;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1 class="text-center">Purchase Order Form</h1>
        <form controller="PurchaseOrder" action="AddOrEditPurchaseOrder" method="post">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Doc_No:</label>
                        <input type="text" class="form-control" id="docNo" asp-for="PurchaseOrder.Doc_No">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Vendor:</label>
                        @Html.DropDownListFor(model => model.PurchaseOrder.VendorID, vendorDropdownList, "Select an option", new { @class = "form-control", id = "vendorID" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Order Date:</label>
                        <input type="date" id="orderDate" class="form-control" asp-for="PurchaseOrder.OrderDate">
                        @Html.ValidationMessageFor(m => m.PurchaseOrder.DeliveryDate)
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">DeliveryDate:</label>
                        <input type="date" id="deliveryDate" class="form-control" asp-for="PurchaseOrder.DeliveryDate">
                        @Html.ValidationMessageFor(m => m.PurchaseOrder.DeliveryDate)
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Total Amount:</label>
                        <input type="number" id="totalNumber" class="form-control" asp-for="PurchaseOrder.TotalAmount">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Tax:</label>
                        <input type="text" id="tax" class="form-control" asp-for="PurchaseOrder.Tax_Percentage" value="12">
                    </div>
                    <input asp-for="PurchaseOrder.CreatedDateTime" class="form-control" type="hidden" />
                    <input asp-for="PurchaseOrder.CreatedBy" class="form-control" type="hidden" />
                    <input asp-for="PurchaseOrder.PurchaseOrderId" class="form-control" type="hidden" />
                </div>
            </div>
            <hr style="width:100%" />
            <div id="poDetailPartial">
                @if (Model != null)
                {
                    @Html.Partial("_PurchaseOrderDetail",Model.PODetail)
                }
                else
                {
                    @Html.Partial("_PurchaseOrderDetail")
                }
            </div>

            <button type="button" class="btn btn-primary" id="btnSave">Submit</button>
        </form>
    </div>
    <!-- Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="~/js/PurchaseOrder.js"></script>
    <script src="~/js/PurchaseOrderDetail.js"></script>
</body>
</html>
