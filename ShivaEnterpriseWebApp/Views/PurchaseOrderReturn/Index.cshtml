@using Newtonsoft.Json
@using ShivaEnterpriseWebApp.Model
@model List<ShivaEnterpriseWebApp.Model.purchaseOrderReturn>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Index";
}
<!DOCTYPE html>
<html lang="en">
<body>
    <div class="modal fade" id="poReturnModalLong" tabindex="-1" role="dialog" aria-labelledby="PoReturnModalLongTitle" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div id="purchaseOrderReturnDiv">
            </div>
        </div>
    </div>

    <!-- partial -->
    <div class="main-panel">
        <div class="content-wrapper">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Purchase Order Return</h4>
                    <div class="compnay_btn">
                        <input class="btn btn-success" type="button" value="Add Purchase Order Return" onclick="window.location.replace('/PurchaseOrderReturn/AddOrEditPurchaseOrderReturn')" />
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="table-responsive">
                                <table id="order-listing" class="table">
                                    <thead>
                                        <tr>
                                            <th>Purchase Order No</th>
                                            <th>Vendor Name</th>
                                            <th>Purchase Order Return Date</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null)
                                        {
                                            @foreach (var item in Model)
                                            {

                                                <tr>
                                                    <td>@item.PurchaseOrder.Doc_No</td>
                                                    <td>@item.Vendor.VendorName</td>
                                                    <td>@item.ReturnDate</td>
                                                    <td>
                                                        @* <input class="btn btn-primary" type="button" value="Edit" onclick="window.location.replace(`/PurchaseOrder/AddOrEditPurchaseOrder?purchaseorderId=@item.PurchaseOrderId`)" /> *@
                                                        <input class="btn btn-outline-danger" type="button" value="Delete" onclick="onDeletePO(@(JsonConvert.SerializeObject(item)))" />
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- content-wrapper ends -->
    </div>


</body>

</html>

<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="~/js/PurchaseReturnOrder.js"></script>
